# =================================================================
# AI-Powered Business Research Assistant - Environment Configuration
# =================================================================
# Choose your preferred provider and add your API key below.
# You can also enter the key directly in the Streamlit application UI.

# 1. OpenAI (Default & Recommended - used in original Codebasics architecture)
# Get key here: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 2. Groq (Fast & Free Tier for Meta Llama 3 models)
# Get key here: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3. Google Gemini
# Get key here: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 4. xAI Grok
# Get key here: https://console.x.ai
XAI_API_KEY=your_xai_api_key_here
